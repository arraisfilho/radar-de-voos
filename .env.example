# Configuration is optional. Never commit an actual .env or SMTP password.
RADAR_HOST=127.0.0.1
# Optional trusted LAN. Enable both lines for access from that subnet only.
# RADAR_HOST=0.0.0.0
# RADAR_LAN_CIDR=192.168.3.0/24
RADAR_PORT=8765
# Defaults to an ignored .data directory in the project.
# RADAR_DATA_DIR=/absolute/path/to/private/local/data
# SMTP is configured in the local app. The password is saved with mode 0600.

# Initial access audit retention; admin settings override this value.
# Cleanup hourly and on new events, capped at 20,000 entries.
RADAR_AUDIT_RETENTION_DAYS=90

# Canonical recovery-link origin, never derived from incoming Host.
# For LAN access set this to the server IP (e.g. http://192.168.3.42:8765).
# For public deployment use the final HTTPS origin.
RADAR_PUBLIC_URL=http://127.0.0.1:8765
# Collection cadence is fixed at 300 seconds. Global gate: 2 requests, 5s between starts.

# Raw responses older than this are pruned hourly in bounded batches.
# Price snapshots, alerts and latest attempt/valid route responses are preserved.
# Integer from 7 to 3650; default 30. Back up the private database before reducing.
RADAR_RAW_RETENTION_DAYS=30

# Completed transport logs: automatic hourly cleanup, max 2,000 per batch.
# Pending/sending messages, price snapshots and opportunity history are preserved.
# Integer from 1 to 3650; default 90. Admin settings override this value.
RADAR_DELIVERY_RETENTION_DAYS=90

# Optional initial OpenWA base URL. No /api/docs; no token in environment examples.
# Admin > Channels > WhatsApp stores provider credentials in a private file.
RADAR_WHATSAPP_URL=

# Docker/public deployment is opt-in. Prefer deploy/cloud.env.example and Compose.
# RADAR_DEPLOYMENT=public
# RADAR_PUBLIC_URL=https://radar.example.com
# RADAR_TRUSTED_PROXY=172.30.88.1
# Public mode disables web bootstrap and public self-registration.
