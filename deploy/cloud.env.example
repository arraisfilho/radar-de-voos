# Copy to deploy/cloud.env (ignored by Git). Hostname only, no protocol/path.
RADAR_DOMAIN=radar.example.com
# Port/interface reached by your existing proxy. Loopback is the safe default.
RADAR_UPSTREAM_PORT=8765
RADAR_PUBLISHED_HOST=127.0.0.1
# The actual TCP peer seen by the app, not the end user's IP.
# Default is the Docker bridge gateway for a proxy installed on the host.
RADAR_TRUSTED_PROXY=172.30.88.1
# Days of raw fare-source responses kept (7 to 3650). Default 30 when unset.
# RADAR_RAW_RETENTION_DAYS=7
